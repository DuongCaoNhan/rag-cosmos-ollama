# Cosmos DB Configuration
USE_EMULATOR=true
DATABASE_NAME=rag_local_llm_db
CONTAINER_NAME=docs

# Ollama Models Configuration  
EMBEDDINGS_MODEL=mxbai-embed-large
DIMENSIONS=1024
CHAT_MODEL=llama3
# Ollama context window (smaller = less VRAM; 4096 fits an 8GB GPU)
NUM_CTX=4096

# RAG Configuration
TOP_K=5

# For cloud Cosmos DB (uncomment and set when using cloud).
# COSMOS_DB_URL is the account endpoint, not a connection string: authentication uses
# DefaultAzureCredential (e.g. `az login`) with a Cosmos DB data-plane role.
# USE_EMULATOR=false
# COSMOS_DB_URL=https://your-account.documents.azure.com:443/
